# ---------------------------------------------------------------------------
# Copy to .env and fill in. docker-compose.yml reads this file.
#   cp .env.example .env
#   echo "PDF_API_KEY=pdf_sk_$(openssl rand -hex 24)" >> .env
# ---------------------------------------------------------------------------

NODE_ENV=production
LOG_LEVEL=info

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080
# Hard HTTP body cap, applied before authentication or parsing.
MAX_REQUEST_BYTES=6291456
API_REQUEST_TIMEOUT_MS=60000
API_TRUST_PROXY=true

# --- Authentication --------------------------------------------------------
# Single key. Generate with: openssl rand -hex 24
PDF_API_KEY=pdf_sk_replace_me
# Or several, as label:secret pairs (labels show up in logs and rate limits):
# PDF_API_KEYS=web:pdf_sk_aaa,batch:pdf_sk_bbb

# --- Rate limiting (per API key) -------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# --- Infrastructure --------------------------------------------------------
# docker-compose overrides both of these with service names.
REDIS_URL=redis://127.0.0.1:6379
GOTENBERG_URL=http://127.0.0.1:3000

# --- Queue and worker ------------------------------------------------------
QUEUE_NAME=pdf
# Start at 1. Raise only when load testing says the machine has room.
WORKER_CONCURRENCY=1
MAX_QUEUED_JOBS=1000
JOB_ATTEMPTS=2
JOB_BACKOFF_MS=2000

# --- Limits ----------------------------------------------------------------
MAX_HTML_BYTES=5242880
MAX_PDF_BYTES=52428800
RENDER_TIMEOUT_MS=30000

# --- Synchronous endpoint --------------------------------------------------
SYNC_ENABLED=true
# After this, POST /v1/pdf/sync hands back a job id instead of a PDF.
SYNC_TIMEOUT_MS=25000

# --- Retention -------------------------------------------------------------
PDF_TTL_SECONDS=3600
FAILED_JOB_TTL_SECONDS=86400
IDEMPOTENCY_TTL_SECONDS=86400
JANITOR_ENABLED=true
JANITOR_INTERVAL_SECONDS=600

# --- Storage ---------------------------------------------------------------
# local = Docker volume (good for development), r2 = Cloudflare R2 / any S3 API.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/data/jobs

# Required when STORAGE_DRIVER=r2:
# R2_BUCKET=pdf-service
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Override only for S3/MinIO/Spaces instead of R2:
# R2_ENDPOINT=
# R2_REGION=auto
# R2_PREFIX=jobs
# Include a presigned download_url in job responses:
# R2_PRESIGN=true
# R2_PRESIGN_TTL_SECONDS=900
