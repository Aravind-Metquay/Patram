# --- General ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# --- Redis / BullMQ ---
# Service DNS name when running via `docker compose up` (api, worker, redis, gotenberg
# all run as containers on the same compose network). If you instead run
# `pnpm dev:api` / `pnpm dev:worker` directly on the host against dockerized
# infra, override this to redis://localhost:6379 and publish that port locally.
REDIS_URL=redis://redis:6379

# --- Gotenberg ---
GOTENBERG_URL=http://gotenberg:3000

# --- API auth ---
# Generate with: node -e "console.log('pdf_sk_' + require('crypto').randomBytes(32).toString('hex'))"
PDF_API_KEY=pdf_sk_changeme

# --- Limits ---
MAX_HTML_BYTES=5242880
MAX_PDF_BYTES=52428800
RENDER_TIMEOUT_MS=30000
SYNC_TIMEOUT_MS=25000
WORKER_CONCURRENCY=1
JOB_ATTEMPTS=2
MAX_QUEUE_SIZE=1000

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pdf-service
# Optional: public bucket base URL (e.g. https://pdf.example.com or the r2.dev URL).
# When unset, download links are signed URLs generated on demand instead.
R2_PUBLIC_BASE_URL=
