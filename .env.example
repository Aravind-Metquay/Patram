# ---------------------------------------------------------------------------
# Copy to .env and fill in. docker-compose.yml reads this file.
#   cp .env.example .env
#   echo "PDF_API_KEY=pdf_sk_$(openssl rand -hex 24)" >> .env
# ---------------------------------------------------------------------------

NODE_ENV=production
LOG_LEVEL=info

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080
# Hard HTTP body cap, applied before authentication or parsing.
MAX_REQUEST_BYTES=6291456
API_REQUEST_TIMEOUT_MS=60000
API_TRUST_PROXY=true

# --- Authentication --------------------------------------------------------
# Single key. Generate with: openssl rand -hex 24
PDF_API_KEY=pdf_sk_replace_me
# Or several, as label:secret pairs (labels show up in logs and rate limits):
# PDF_API_KEYS=web:pdf_sk_aaa,batch:pdf_sk_bbb

# --- Rate limiting (per API key) -------------------------------------------
RATE_LIMIT_ENABLED=true
# Render requests (POST /v1/pdf, /v1/pdf/sync).
RATE_LIMIT_MAX=60
# Status polls and downloads - clients are expected to poll, so this is higher.
RATE_LIMIT_READ_MAX=600
RATE_LIMIT_WINDOW_MS=60000

# --- Infrastructure --------------------------------------------------------
# docker-compose overrides both of these with service names.
REDIS_URL=redis://127.0.0.1:6379
GOTENBERG_URL=http://127.0.0.1:3000

# --- Queue and worker ------------------------------------------------------
QUEUE_NAME=pdf
# Renders in flight per worker process. 2 is the measured sweet spot on a
# 4-core dev machine (see the benchmark log in PROGRESS.md); drop to 1 on a
# 2 GB / single-vCPU box, and re-measure on the VPS before raising it.
# Whatever you set here, match --chromium-max-concurrency in docker-compose.yml.
WORKER_CONCURRENCY=2
MAX_QUEUED_JOBS=1000
JOB_ATTEMPTS=2
JOB_BACKOFF_MS=2000

# --- Limits ----------------------------------------------------------------
MAX_HTML_BYTES=5242880
MAX_PDF_BYTES=52428800
RENDER_TIMEOUT_MS=30000

# --- Synchronous endpoint --------------------------------------------------
SYNC_ENABLED=true
# After this, POST /v1/pdf/sync hands back a job id instead of a PDF.
SYNC_TIMEOUT_MS=25000

# --- Uploading to a caller-supplied presigned URL --------------------------
# When a request carries an `upload` object, Patram PUTs the finished PDF to that
# URL instead of the caller downloading it. Patram never sees your storage
# credentials - the signed URL is the whole authorisation.
UPLOAD_ENABLED=true
# Per-attempt deadline for the upload itself.
UPLOAD_TIMEOUT_MS=30000
# Patram makes an outbound request to an address a client chose, so both of these
# stay off in production. Loopback, private, link-local (cloud instance metadata
# lives at 169.254.169.254), CGNAT and reserved ranges are refused either way -
# at parse time for IP literals, and at connect time for the address actually
# dialled, so DNS rebinding cannot slip past.
UPLOAD_ALLOW_HTTP=false
UPLOAD_ALLOW_PRIVATE_IPS=false
# Optional comma-separated host suffixes. Empty means any public host is allowed;
# set it on any instance whose API keys are handed to third parties.
# UPLOAD_HOST_ALLOWLIST=r2.cloudflarestorage.com,s3.amazonaws.com
# How much of the destination's response body to pass back on a failure. It is
# what tells SignatureDoesNotMatch from AccessDenied. Set 0 to stop echoing it.
UPLOAD_MAX_RESPONSE_BYTES=4096
# Extra tries within the same job attempt when the destination answers 429/408,
# honouring Retry-After.
UPLOAD_THROTTLE_RETRIES=2

# --- Retention -------------------------------------------------------------
PDF_TTL_SECONDS=3600
FAILED_JOB_TTL_SECONDS=86400
IDEMPOTENCY_TTL_SECONDS=86400
JANITOR_ENABLED=true
JANITOR_INTERVAL_SECONDS=600

# --- Observability ---------------------------------------------------------
# Prometheus endpoints on ports that are NOT published to the host: the API on
# API_METRICS_PORT and the worker on WORKER_METRICS_PORT, both scraped from
# inside the compose network.
METRICS_ENABLED=true
API_METRICS_PORT=9090
WORKER_METRICS_PORT=9091
# Each process logs a "vitals" line this often: process CPU/RSS/event loop plus
# host CPU including steal, load, memory and queue depth. 10-15s while load
# testing, 30-60s in steady state.
VITALS_INTERVAL_SECONDS=30
# Renders slower than this are logged at warn level.
SLOW_RENDER_LOG_MS=10000
# Per-request API access logs. Set false if they drown the interesting lines.
LOG_HTTP_REQUESTS=true
# Grafana admin login for the optional monitoring profile.
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me

# --- Storage ---------------------------------------------------------------
# local = Docker volume (good for development), r2 = Cloudflare R2 / any S3 API.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/data/jobs

# Required when STORAGE_DRIVER=r2:
# R2_BUCKET=pdf-service
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Override only for S3/MinIO/Spaces instead of R2:
# R2_ENDPOINT=
# R2_REGION=auto
# R2_PREFIX=jobs
# Include a presigned download_url in job responses:
# R2_PRESIGN=true
# R2_PRESIGN_TTL_SECONDS=900
